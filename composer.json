{
    "name": "nickdekruijk/settings",
    "description": "A basic cache enabled Setting model, migration and helper for your Laravel project",
    "license": "MIT",
    "keywords": ["php", "laravel", "settings", "setting"],
    "authors": [{
        "name": "Nick de Kruijk",
        "email": "git@nickdekruijk.nl"
    }],
    "minimum-stability": "dev",
    "require": {
        "php": ">=7.0.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NickDeKruijk\\Settings\\ServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "NickDeKruijk\\Settings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NickDeKruijk\\Settings\\Tests\\": "tests/"
        }
    }
}
